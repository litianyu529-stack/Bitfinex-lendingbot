[BITFINEX]
# Prefer BITFINEX_API_KEY / BITFINEX_API_SECRET environment variables.
apikey = YourBitfinexAPIKey
secret = YourBitfinexSecret
currencies = USD

[BOT]
# The worker only starts when --live is explicitly supplied and preflight passes.
sleeptimeactive = 60
sleeptimeinactive = 300
statedbfile = .state/lendingbot-v3.sqlite3

# Optional transfer into the funding wallet. Comment transferablecurrencies to disable.
# transferablecurrencies = USD
transferfromwallets = exchange,margin

# Dashboard status output.
# jsonfile = www/botlog.json
# jsonlogsize = 200
# startwebserver = true
outputcurrency = USD

[STRATEGY_V3]
# Net simple APR percentages after provider fees. LIVE requires all three.
short_floor_apr =
medium_floor_apr =
long_floor_apr =

# Term pools and execution layers must each total 100.
short_share = 50
medium_share = 35
long_share = 15
quick_share = 40
balanced_share = 40
high_share = 20

short_periods = 2,7
medium_periods = 14,30
long_periods = 120
max_lend_amount =
max_lend_percent = 100

normal_fee_rate = 15
hidden_fee_rate = 18
enable_limit = true
enable_frr = true
enable_frr_delta_fixed = true
enable_frr_delta_variable = true
variable_max_share = 10
enable_hidden = false
adopt_external_offers = false
hidden_max_share =

minimum_offer_minutes = 10
short_reprice_stages_minutes = 10,30,60,90,120,180
medium_reprice_stages_minutes = 20,60,120,180,240,360
long_reprice_stages_minutes = 60,180,360,480,720,1440
reprice_cooldown_minutes = 10
max_reprices_per_hour = 6
minimum_rate_change = 0.002
iqr_change_fraction = 0.25
spike_volume_ratio = 1.5
outlier_min_volume_share = 0.5
ws_fallback_seconds = 300
rest_stale_seconds = 60
market_retention_days = 90

# Candidate-scoring weights are deliberately not user-configurable. They are
# versioned in StrategyV3.py and may change only through offline research evidence.
